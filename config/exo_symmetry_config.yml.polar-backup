Subject:
  id: P996
  session: S001
  base_dir: /Users/maccamardo/HITLO_Data
Cost:
  aim: Aim 1
  sample_rate: 200
  time: 90
  signed: true
  si_target: -3.0
  trim_seconds: 3.0
Optimization:
  index_csv: config/index_unified.csv
  n_parms: 1
  range:
  - - -1.0
  - - 1.0
  n_steps: 15
  manual_ramp_trials: 5
  ramp_sequence:
  - -1.0
  - 0.0
  - 0.3
  - 0.633333333333333
  - 1.0
  device: cpu
  normalize: true
  acquisition: ei
  kernel_function: se
  model_save_path: auto
  result_save_path: auto
Parameters:
  x:
    name: Unified Stiffness Index
    unit: dimensionless
    description: '-1 = max dorsiflexor stiffness, 0 = zero torque, +1 = max plantarflexor.
      Ordered on effective rotational stiffness (dtau/dtheta over the traversed ROM),
      which anchors the search space to Collins/Wiggin/Sawicki 2015 (~180 Nm/rad).
      Maps to (R, theta, L0, attachment_ratio) via index_csv.

      x = 0 is NOT device-off. The 24 rubber bands are always on, so the controller
      must actively cancel them: tau_cable = 0 - tau_band(theta). On the DF arm generally,
      the controller renders the target curve as tau_cable = tau_desired - tau_band(theta).'
